{
  "realm": "ops",
  "displayName": "SecOps Operations",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "client": {
      "ops-dashboard": [
        {
          "name": "viewer",
          "description": "Read the Ops Dashboard",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "admin",
          "description": "Use the Ops Dashboard administrative view",
          "composite": false,
          "clientRole": true
        }
      ],
      "asset-inventory": [
        {
          "name": "viewer",
          "description": "Read Asset Inventory",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "editor",
          "description": "Edit Asset Inventory",
          "composite": false,
          "clientRole": true
        }
      ],
      "runbook-portal": [
        {
          "name": "reader",
          "description": "Read runbooks",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "publisher",
          "description": "Publish runbooks",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "ops-dashboard",
      "name": "Ops Dashboard",
      "description": "Mandatory future Flask OIDC relying party",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://ops.localhost:18083/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": [
        "profile",
        "ops-dashboard-roles"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "asset-inventory",
      "name": "Asset Inventory",
      "description": "Design-only client; no application exists in this POC",
      "enabled": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "runbook-portal",
      "name": "Runbook Portal",
      "description": "Design-only client; no application exists in this POC",
      "enabled": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "ops-dashboard-roles",
      "description": "ID-token-only Ops Dashboard client roles",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "ops-dashboard roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "ops-dashboard",
            "claim.name": "ops_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "lightweight.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "ops-dashboard": [
      {
        "clientScope": "ops-dashboard-roles",
        "roles": [
          "viewer",
          "admin"
        ]
      }
    ]
  },
  "groups": [
    {
      "name": "ops-viewers",
      "clientRoles": {
        "ops-dashboard": [
          "viewer"
        ]
      }
    },
    {
      "name": "ops-admins",
      "clientRoles": {
        "ops-dashboard": [
          "viewer",
          "admin"
        ]
      }
    },
    {
      "name": "asset-inventory-viewers",
      "clientRoles": {
        "asset-inventory": [
          "viewer"
        ]
      }
    },
    {
      "name": "runbook-publishers",
      "clientRoles": {
        "runbook-portal": [
          "reader",
          "publisher"
        ]
      }
    }
  ],
  "scopeMappings": []
}
